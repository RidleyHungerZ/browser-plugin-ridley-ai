{
  "manifest_version": 3,
  "name": "Ridley-AI",
  "version": "0.1.0",
  "description": "个人用 AI 侧边栏助手：选中文字右键询问，记录保存在 ~/.ridley-ai",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "nativeMessaging",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Ridley-AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
